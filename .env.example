# Configuración local. Cambiar la clave antes de usar en producción.
SECRET_KEY=misso-solo-desarrollo-cambiar-en-produccion
DEBUG=True
# Sin DATABASE_URL se usa SQLite en la raíz del proyecto.
# DATABASE_URL=postgresql://usuario:password@localhost:5432/misso
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
EMAIL_HOST_USER=

# URLs públicas para retornos y links absolutos de emails (HTTPS).
SITE_URL=https://misso.ar
# Suscripciones: habilitar solo tras configurar el entorno de prueba y el worker.
MP_SUBSCRIPTION_ENABLED=False
MP_SUBSCRIPTION_AMOUNT=25000
MP_SUBSCRIPTION_CURRENCY=ARS
MP_SUBSCRIPTION_REASON=Misso — Suscripción mensual
# Vacío para checkout alojado con preapproval pending; ver docs/suscripciones.md.
MP_SUBSCRIPTION_PLAN_ID=
MP_WEBHOOK_SECRET=
# Si se omite, se reutiliza EMAIL_HOST_USER (NOTIFICACION_EMAIL).
MISSO_ADMIN_EMAIL=
MISSO_EMAIL_FROM=Misso <hola@misso.ar>

# Test aislado: Access Token del VENDEDOR de prueba, no de la cuenta real.
MP_SUBSCRIPTION_MODE=test
MP_SUBSCRIPTION_TEST_ACCESS_TOKEN=
# Origen HTTPS de ngrok/staging, sin ruta ni slash final.
PUBLIC_BASE_URL=
